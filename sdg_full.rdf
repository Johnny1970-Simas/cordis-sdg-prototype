<rdf:Description rdf:about="http://data.europa.eu/sdg/4">
    <ns1:narrower rdf:resource="http://data.europa.eu/sdg/4.6" />
    <ns6:hasTarget rdf:resource="http://data.europa.eu/sdg/4.6" />
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/sdg/4.6">
    <rdf:type rdf:resource="http://metadata.un.org/sdg/ontology#Target" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <ns2:versionInfo>1.0</ns2:versionInfo>
    <ns1:prefLabel xml:lang="fr">D’ici à 2030, faire en sorte que tous les jeunes et une proportion considérable d’adultes, hommes et femmes, sachent lire, écrire et compter</ns1:prefLabel>
    <ns1:prefLabel xml:lang="es">De aquí a 2030, asegurar que todos los jóvenes y una proporción considerable de los adultos, tanto hombres como mujeres, estén alfabetizados y tengan nociones elementales de aritmética</ns1:prefLabel>
    <ns1:prefLabel xml:lang="en">By 2030, ensure that all youth and a substantial proportion of adults, both men and women, achieve literacy and numeracy</ns1:prefLabel>
    <ns4:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-10</ns4:created>
    <ns1:inScheme rdf:resource="http://data.europa.eu/sdg" />
    <ns7:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-23</ns7:startDate>
    <ns5:prefLabel rdf:resource="http://data.europa.eu/sdg/label_9568dcd43a" />
    <ns5:prefLabel rdf:resource="http://data.europa.eu/sdg/label_45be23c37d" />
    <ns5:prefLabel rdf:resource="http://data.europa.eu/sdg/label_4a2b368cf6" />
    <dc:identifier>4.6</dc:identifier>
    <ns1:broader rdf:resource="http://data.europa.eu/sdg/4" />
    <ns1:narrower rdf:resource="http://data.europa.eu/sdg/C040601" />
