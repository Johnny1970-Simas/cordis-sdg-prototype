  <rdf:Description rdf:about="http://data.europa.eu/sdg/5.3">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="http://metadata.un.org/sdg/ontology#Target" />
    <ns2:versionInfo>1.0</ns2:versionInfo>
    <ns1:prefLabel xml:lang="es">Eliminar todas las prácticas nocivas, como el matrimonio infantil, precoz y forzado y la mutilación genital femenina</ns1:prefLabel>
    <ns1:prefLabel xml:lang="en">Eliminate all harmful practices, such as child, early and forced marriage and female genital mutilation</ns1:prefLabel>
    <ns1:prefLabel xml:lang="fr">Éliminer toutes les pratiques préjudiciables, telles que le mariage des enfants, le mariage précoce ou forcé et la mutilation génitale féminine</ns1:prefLabel>
