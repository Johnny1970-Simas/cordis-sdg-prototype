    <ns1:notation rdf:datatype="http://metadata.un.org/sdg/ontology#SDGCodeCompact">4.5</ns1:notation>
    <ns1:notation rdf:datatype="http://metadata.un.org/sdg/ontology#SDGCode">04.05</ns1:notation>
    <ns7:status rdf:resource="http://publications.europa.eu/resource/authority/concept-status/CURRENT" />
