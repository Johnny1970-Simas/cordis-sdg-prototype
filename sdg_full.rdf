  <rdf:Description rdf:about="http://data.europa.eu/sdg/11.4">
    <rdf:type rdf:resource="http://metadata.un.org/sdg/ontology#Target" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <ns2:versionInfo>1.0</ns2:versionInfo>
    <ns1:prefLabel xml:lang="en">Strengthen efforts to protect and safeguard the world’s cultural and natural heritage</ns1:prefLabel>
    <ns1:prefLabel xml:lang="fr">Redoubler d’efforts pour protéger et préserver le patrimoine culturel et naturel mondial</ns1:prefLabel>
    <ns1:prefLabel xml:lang="es">Redoblar los esfuerzos para proteger y salvaguardar el patrimonio cultural y natural del mundo</ns1:prefLabel>
    <ns4:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-10</ns4:created>
    <ns1:inScheme rdf:resource="http://data.europa.eu/sdg" />
