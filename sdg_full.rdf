    <ns5:prefLabel rdf:resource="http://data.europa.eu/sdg/label_f15174384f" />
    <dc:identifier>13.a</dc:identifier>
    <ns1:broader rdf:resource="http://data.europa.eu/sdg/13" />
    <ns1:narrower rdf:resource="http://data.europa.eu/sdg/C130a01" />
