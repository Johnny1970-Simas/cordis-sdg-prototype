    <ns5:prefLabel rdf:resource="http://data.europa.eu/sdg/label_f03a9bf7c4" />
    <ns5:prefLabel rdf:resource="http://data.europa.eu/sdg/label_128912e269" />
    <dc:identifier>17.17</dc:identifier>
