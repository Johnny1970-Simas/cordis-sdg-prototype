  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/sdg/C010401">
    <ns1:broader rdf:resource="http://data.europa.eu/sdg/1.4" />
    <ns6:isIndicatorOf rdf:resource="http://data.europa.eu/sdg/1.4" />
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/sdg/C010402">
    <ns1:broader rdf:resource="http://data.europa.eu/sdg/1.4" />
    <ns6:isIndicatorOf rdf:resource="http://data.europa.eu/sdg/1.4" />
  </rdf:Description>
<rdf:Description rdf:about="http://data.europa.eu/sdg/1">
    <ns1:narrower rdf:resource="http://data.europa.eu/sdg/1.5" />
    <ns6:hasTarget rdf:resource="http://data.europa.eu/sdg/1.5" />
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/sdg/1.5">
    <rdf:type rdf:resource="http://metadata.un.org/sdg/ontology#Target" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <ns2:versionInfo>1.0</ns2:versionInfo>
    <ns1:prefLabel xml:lang="fr">D’ici à 2030, renforcer la résilience des pauvres et des personnes en situation vulnérable et réduire leur exposition aux phénomènes climatiques extrêmes et à d’autres chocs et catastrophes d’ordre économique, social ou environnemental et leur vulnérabilité</ns1:prefLabel>
    <ns1:prefLabel xml:lang="es">De aquí a 2030, fomentar la resiliencia de los pobres y las personas que se encuentran en situaciones de vulnerabilidad y reducir su exposición y vulnerabilidad a los fenómenos extremos relacionados con el clima y otras perturbaciones y desastres económicos, sociales y ambientales</ns1:prefLabel>
    <ns1:prefLabel xml:lang="en">By 2030, build the resilience of the poor and those in vulnerable situations and reduce their exposure and vulnerability to climate-related extreme events and other economic, social and environmental shocks and disasters</ns1:prefLabel>
    <ns4:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-10</ns4:created>
    <ns1:inScheme rdf:resource="http://data.europa.eu/sdg" />
    <ns7:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-23</ns7:startDate>
    <ns5:prefLabel rdf:resource="http://data.europa.eu/sdg/label_0bbaf30e09" />
    <ns5:prefLabel rdf:resource="http://data.europa.eu/sdg/label_0cc59c204a" />
    <ns5:prefLabel rdf:resource="http://data.europa.eu/sdg/label_3b9a5abbe3" />
    <dc:identifier>1.5</dc:identifier>
    <ns1:broader rdf:resource="http://data.europa.eu/sdg/1" />
    <ns1:narrower rdf:resource="http://data.europa.eu/sdg/C200305" />
