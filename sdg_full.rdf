  </rdf:Description>
<rdf:Description rdf:about="http://data.europa.eu/sdg">
    <ns1:hasTopconcept rdf:resource="http://data.europa.eu/sdg/12" />
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/sdg/12">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="http://metadata.un.org/sdg/ontology#Goal" />
    <ns2:versionInfo>1.0</ns2:versionInfo>
    <ns1:prefLabel xml:lang="en">Ensure sustainable consumption and production patterns</ns1:prefLabel>
    <ns1:prefLabel xml:lang="es">Garantizar modalidades de consumo y producción sostenibles</ns1:prefLabel>
    <ns1:prefLabel xml:lang="fr">Établir des modes de consommation et de production durables</ns1:prefLabel>
    <ns4:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-10</ns4:created>
    <ns1:inScheme rdf:resource="http://data.europa.eu/sdg" />
