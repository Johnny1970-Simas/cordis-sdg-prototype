    <ns7:xlNotation rdf:resource="http://data.europa.eu/sdg/notation_6be4792b20" />
    <ns7:xlNotation rdf:resource="http://data.europa.eu/sdg/notation_3b7f40e9db" />
    <ns7:xlNotation rdf:resource="http://data.europa.eu/sdg/notation_928170a08c" />
    <ns7:xlNote rdf:resource="http://data.europa.eu/sdg/note_c0dfaad878" />
