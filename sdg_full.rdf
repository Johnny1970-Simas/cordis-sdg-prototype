<rdf:Description rdf:about="http://data.europa.eu/sdg/C120b01">
    <ns1:broader rdf:resource="http://data.europa.eu/sdg/12.b" />
    <ns6:isIndicatorOf rdf:resource="http://data.europa.eu/sdg/12.b" />
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/sdg/12">
    <ns1:narrower rdf:resource="http://data.europa.eu/sdg/12.b" />
    <ns6:hasTarget rdf:resource="http://data.europa.eu/sdg/12.b" />
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/sdg/12.b">
    <rdf:type rdf:resource="http://metadata.un.org/sdg/ontology#Target" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <ns2:versionInfo>1.0</ns2:versionInfo>
    <ns1:prefLabel xml:lang="en">Develop and implement tools to monitor sustainable development impacts for sustainable tourism that creates jobs and promotes local culture and products</ns1:prefLabel>
    <ns1:prefLabel xml:lang="fr">Mettre au point et utiliser des outils de contrôle de l’impact sur le développement durable d’un tourisme durable créateur d’emplois et valorisant la culture et les produits locaux</ns1:prefLabel>
    <ns1:prefLabel xml:lang="es">Elaborar y aplicar instrumentos para vigilar los efectos en el desarrollo sostenible, a fin de lograr un turismo sostenible que cree puestos de trabajo y promueva la cultura y los productos locales</ns1:prefLabel>
    <ns4:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-10</ns4:created>
    <ns1:inScheme rdf:resource="http://data.europa.eu/sdg" />
    <ns7:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-23</ns7:startDate>
    <ns5:prefLabel rdf:resource="http://data.europa.eu/sdg/label_f6cc77af8f" />
    <ns5:prefLabel rdf:resource="http://data.europa.eu/sdg/label_18df891e0a" />
    <ns5:prefLabel rdf:resource="http://data.europa.eu/sdg/label_8ed0fd3a67" />
    <dc:identifier>12.b</dc:identifier>
    <ns1:broader rdf:resource="http://data.europa.eu/sdg/12" />
    <ns1:narrower rdf:resource="http://data.europa.eu/sdg/C120b01" />
    <ns1:notation rdf:datatype="http://metadata.un.org/sdg/ontology#SDGCodeCompact">12.b</ns1:notation>
    <ns1:notation rdf:datatype="http://metadata.un.org/sdg/ontology#SDGCode">12.0b</ns1:notation>
    <ns1:notation>12.b</ns1:notation>
