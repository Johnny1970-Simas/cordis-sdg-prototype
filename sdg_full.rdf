<rdf:Description rdf:about="http://data.europa.eu/sdg/C040501">
    <ns1:broader rdf:resource="http://data.europa.eu/sdg/4.5" />
    <ns6:isIndicatorOf rdf:resource="http://data.europa.eu/sdg/4.5" />
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/sdg/4">
    <ns1:narrower rdf:resource="http://data.europa.eu/sdg/4.5" />
