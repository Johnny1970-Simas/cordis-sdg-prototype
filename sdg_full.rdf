  <rdf:Description rdf:about="http://data.europa.eu/sdg/17">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="http://metadata.un.org/sdg/ontology#Goal" />
    <ns2:versionInfo>1.0</ns2:versionInfo>
    <ns1:prefLabel xml:lang="fr">Renforcer les moyens de mettre en œuvre le Partenariat mondial pour le développement durable et le revitaliser</ns1:prefLabel>
    <ns1:prefLabel xml:lang="en">Strengthen the means of implementation and revitalize the Global Partnership for Sustainable Development</ns1:prefLabel>
    <ns1:prefLabel xml:lang="es">Fortalecer los medios de implementación y revitalizar la Alianza Mundial para el Desarrollo Sostenible</ns1:prefLabel>
