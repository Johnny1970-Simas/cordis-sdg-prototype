    <ns1:broader rdf:resource="http://data.europa.eu/sdg/14.2" />
    <ns6:isIndicatorOf rdf:resource="http://data.europa.eu/sdg/14.2" />
  </rdf:Description>
<rdf:Description rdf:about="http://data.europa.eu/sdg/14.3">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="http://metadata.un.org/sdg/ontology#Target" />
    <ns2:versionInfo>1.0</ns2:versionInfo>
    <ns1:prefLabel xml:lang="en">Minimize and address the impacts of ocean acidification, including through enhanced scientific cooperation at all levels</ns1:prefLabel>
    <ns1:prefLabel xml:lang="fr">Réduire au maximum l’acidification des océans et lutter contre ses effets, notamment en renforçant la coopération scientifique à tous les niveaux</ns1:prefLabel>
    <ns1:prefLabel xml:lang="es">Minimizar y abordar los efectos de la acidificación de los océanos, incluso mediante una mayor cooperación científica a todos los niveles</ns1:prefLabel>
    <ns4:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-10</ns4:created>
    <ns1:inScheme rdf:resource="http://data.europa.eu/sdg" />
    <ns7:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-23</ns7:startDate>
    <ns5:prefLabel rdf:resource="http://data.europa.eu/sdg/label_66a99608fb" />
    <ns5:prefLabel rdf:resource="http://data.europa.eu/sdg/label_a859ae7bba" />
    <ns5:prefLabel rdf:resource="http://data.europa.eu/sdg/label_1e04375671" />
