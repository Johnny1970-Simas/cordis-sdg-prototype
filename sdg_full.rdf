    <ns1:prefLabel xml:lang="fr">Garantir l’accès de tous à des services d’alimentation en eau et d’assainissement gérés de façon durable</ns1:prefLabel>
    <ns1:prefLabel xml:lang="es">Garantizar la disponibilidad y la gestión sostenible del agua y el saneamiento para todos</ns1:prefLabel>
