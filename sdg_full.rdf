  <rdf:Description rdf:about="http://data.europa.eu/sdg/10">
    <ns1:narrower rdf:resource="http://data.europa.eu/sdg/10.c" />
    <ns6:hasTarget rdf:resource="http://data.europa.eu/sdg/10.c" />
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/sdg/10.c">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="http://metadata.un.org/sdg/ontology#Target" />
    <ns2:versionInfo>1.0</ns2:versionInfo>
    <ns1:prefLabel xml:lang="fr">D’ici à 2030, faire baisser au-dessous de 3 pour cent les coûts de transaction des envois de fonds effectués par les migrants et éliminer les circuits d’envois de fonds dont les coûts sont supérieurs à 5 pour cent</ns1:prefLabel>
    <ns1:prefLabel xml:lang="en">By 2030, reduce to less than 3 per cent the transaction costs of migrant remittances and eliminate remittance corridors with costs higher than 5 per cent</ns1:prefLabel>
    <ns1:prefLabel xml:lang="es">De aquí a 2030, reducir a menos del 3% los costos de transacción de las remesas de los migrantes y eliminar los corredores de remesas con un costo superior al 5%</ns1:prefLabel>
    <ns4:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-10</ns4:created>
    <ns1:inScheme rdf:resource="http://data.europa.eu/sdg" />
