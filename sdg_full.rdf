<rdf:Description rdf:about="http://data.europa.eu/sdg/7.2">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="http://metadata.un.org/sdg/ontology#Target" />
    <ns2:versionInfo>1.0</ns2:versionInfo>
    <ns1:prefLabel xml:lang="es">De aquí a 2030, aumentar considerablemente la proporción de energía renovable en el conjunto de fuentes energéticas</ns1:prefLabel>
    <ns1:prefLabel xml:lang="fr">D’ici à 2030, accroître nettement la part de l’énergie renouvelable dans le bouquet énergétique mondial</ns1:prefLabel>
    <ns1:prefLabel xml:lang="en">By 2030, increase substantially the share of renewable energy in the global energy mix</ns1:prefLabel>
    <ns4:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-10</ns4:created>
