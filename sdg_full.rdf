  <rdf:Description rdf:about="http://data.europa.eu/sdg/11">
    <rdf:type rdf:resource="http://metadata.un.org/sdg/ontology#Goal" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <ns2:versionInfo>1.0</ns2:versionInfo>
    <ns1:prefLabel xml:lang="fr">Faire en sorte que les villes et les établissements humains soient ouverts à tous, sûrs, résilients et durables</ns1:prefLabel>
    <ns1:prefLabel xml:lang="es">Lograr que las ciudades y los asentamientos humanos sean inclusivos, seguros, resilientes y sostenibles</ns1:prefLabel>
    <ns1:prefLabel xml:lang="en">Make cities and human settlements inclusive, safe, resilient and sustainable</ns1:prefLabel>
    <ns4:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-10</ns4:created>
    <ns1:inScheme rdf:resource="http://data.europa.eu/sdg" />
