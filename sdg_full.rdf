    <ns5:prefLabel rdf:resource="http://data.europa.eu/sdg/label_f420b6d32d" />
    <ns5:prefLabel rdf:resource="http://data.europa.eu/sdg/label_cc99d71ab7" />
    <dc:identifier>15.c</dc:identifier>
    <ns1:broader rdf:resource="http://data.europa.eu/sdg/15" />
    <ns1:narrower rdf:resource="http://data.europa.eu/sdg/C200206" />
