    <ns5:prefLabel rdf:resource="http://data.europa.eu/sdg/label_5c9f98a879" />
    <ns5:prefLabel rdf:resource="http://data.europa.eu/sdg/label_7eab053b34" />
    <dc:identifier>2.4</dc:identifier>
    <ns1:broader rdf:resource="http://data.europa.eu/sdg/2" />
    <ns1:narrower rdf:resource="http://data.europa.eu/sdg/C020401" />
