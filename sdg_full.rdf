  <rdf:Description rdf:about="http://data.europa.eu/sdg/12.2">
    <rdf:type rdf:resource="http://metadata.un.org/sdg/ontology#Target" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <ns2:versionInfo>1.0</ns2:versionInfo>
    <ns1:prefLabel xml:lang="en">By 2030, achieve the sustainable management and efficient use of natural resources</ns1:prefLabel>
    <ns1:prefLabel xml:lang="es">De aquí a 2030, lograr la gestión sostenible y el uso eficiente de los recursos naturales</ns1:prefLabel>
    <ns1:prefLabel xml:lang="fr">D’ici à 2030, parvenir à une gestion durable et à une utilisation rationnelle des ressources naturelles</ns1:prefLabel>
    <ns4:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-10</ns4:created>
    <ns1:inScheme rdf:resource="http://data.europa.eu/sdg" />
    <ns7:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-23</ns7:startDate>
