    <ns7:xlNotation rdf:resource="http://data.europa.eu/sdg/notation_ae8d2d2549" />
    <ns7:xlNotation rdf:resource="http://data.europa.eu/sdg/notation_78b97ee101" />
    <ns7:xlNote rdf:resource="http://data.europa.eu/sdg/note_b85f82265e" />
    <ns7:xlNote rdf:resource="http://data.europa.eu/sdg/note_292cc4efa9" />
