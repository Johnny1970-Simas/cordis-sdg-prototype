    <ns1:prefLabel xml:lang="es">Garantizar una vida sana y promover el bienestar de todos a todas las edades</ns1:prefLabel>
    <ns1:prefLabel xml:lang="en">Ensure healthy lives and promote well-being for all at all ages</ns1:prefLabel>
    <ns1:prefLabel xml:lang="fr">Permettre à tous de vivre en bonne santé et promouvoir le bien-être de tous à tout âge</ns1:prefLabel>
