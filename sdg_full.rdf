  <rdf:Description rdf:about="http://data.europa.eu/sdg/17">
    <ns1:narrower rdf:resource="http://data.europa.eu/sdg/17.19" />
    <ns6:hasTarget rdf:resource="http://data.europa.eu/sdg/17.19" />
