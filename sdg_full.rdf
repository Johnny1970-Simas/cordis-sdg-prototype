  <rdf:Description rdf:about="http://data.europa.eu/sdg/7">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="http://metadata.un.org/sdg/ontology#Goal" />
    <ns2:versionInfo>1.0</ns2:versionInfo>
    <ns1:prefLabel xml:lang="en">Ensure access to affordable, reliable, sustainable and modern energy for all</ns1:prefLabel>
    <ns1:prefLabel xml:lang="fr">Garantir l’accès de tous à des services énergétiques fiables, durables et modernes, à un coût abordable</ns1:prefLabel>
    <ns1:prefLabel xml:lang="es">Garantizar el acceso a una energía asequible, fiable, sostenible y moderna para todos</ns1:prefLabel>
    <ns4:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-10</ns4:created>
    <ns1:inScheme rdf:resource="http://data.europa.eu/sdg" />
