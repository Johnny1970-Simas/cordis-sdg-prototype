    <ns1:notation rdf:datatype="http://metadata.un.org/sdg/ontology#SDGCode">14.05</ns1:notation>
    <ns1:notation rdf:datatype="http://metadata.un.org/sdg/ontology#SDGCodeCompact">14.5</ns1:notation>
    <ns1:notation>14.5</ns1:notation>
    <ns7:status rdf:resource="http://publications.europa.eu/resource/authority/concept-status/CURRENT" />
    <ns7:xlNotation rdf:resource="http://data.europa.eu/sdg/notation_ceecc2a617" />
    <ns7:xlNotation rdf:resource="http://data.europa.eu/sdg/notation_310b12de39" />
    <ns7:xlNotation rdf:resource="http://data.europa.eu/sdg/notation_665f12b8ed" />
    <ns7:xlNote rdf:resource="http://data.europa.eu/sdg/note_67fa84dbf5" />
