    <ns1:notation rdf:datatype="http://metadata.un.org/sdg/ontology#SDGCodeCompact">11.a</ns1:notation>
    <ns1:notation>11.a</ns1:notation>
    <ns7:status rdf:resource="http://publications.europa.eu/resource/authority/concept-status/CURRENT" />
    <ns7:xlNotation rdf:resource="http://data.europa.eu/sdg/notation_5904a35b35" />
