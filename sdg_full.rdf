    <ns5:prefLabel rdf:resource="http://data.europa.eu/sdg/label_265fba9e97" />
    <ns5:prefLabel rdf:resource="http://data.europa.eu/sdg/label_80aab3c98a" />
    <dc:identifier>11.a</dc:identifier>
    <ns1:broader rdf:resource="http://data.europa.eu/sdg/11" />
    <ns1:narrower rdf:resource="http://data.europa.eu/sdg/C110a01" />
