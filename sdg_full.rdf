<rdf:Description rdf:about="http://data.europa.eu/sdg/6">
    <ns1:narrower rdf:resource="http://data.europa.eu/sdg/6.5" />
    <ns6:hasTarget rdf:resource="http://data.europa.eu/sdg/6.5" />
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/sdg/6.5">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="http://metadata.un.org/sdg/ontology#Target" />
    <ns2:versionInfo>1.0</ns2:versionInfo>
    <ns1:prefLabel xml:lang="en">By 2030, implement integrated water resources management at all levels, including through transboundary cooperation as appropriate</ns1:prefLabel>
    <ns1:prefLabel xml:lang="es">De aquí a 2030, implementar la gestión integrada de los recursos hídricos a todos los niveles, incluso mediante la cooperación transfronteriza, según proceda</ns1:prefLabel>
    <ns1:prefLabel xml:lang="fr">D’ici à 2030, assurer la gestion intégrée des ressources en eau à tous les niveaux, y compris au moyen de la coopération transfrontière selon qu’il convient</ns1:prefLabel>
    <ns4:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-10</ns4:created>
    <ns1:inScheme rdf:resource="http://data.europa.eu/sdg" />
