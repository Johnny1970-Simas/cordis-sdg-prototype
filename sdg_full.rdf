    <ns5:prefLabel rdf:resource="http://data.europa.eu/sdg/label_42cd484c2b" />
    <ns5:prefLabel rdf:resource="http://data.europa.eu/sdg/label_e1d1f64f5c" />
    <dc:identifier>C130201</dc:identifier>
