    <ns5:prefLabel rdf:resource="http://data.europa.eu/sdg/label_9e892b7633" />
    <ns5:prefLabel rdf:resource="http://data.europa.eu/sdg/label_b298c0dcaf" />
    <dc:identifier>11.1</dc:identifier>
    <ns1:broader rdf:resource="http://data.europa.eu/sdg/11" />
