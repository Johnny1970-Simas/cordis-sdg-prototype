  <rdf:Description rdf:about="http://data.europa.eu/sdg/14">
    <rdf:type rdf:resource="http://metadata.un.org/sdg/ontology#Goal" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <ns2:versionInfo>1.0</ns2:versionInfo>
    <ns1:prefLabel xml:lang="es">Conservar y utilizar sosteniblemente los océanos, los mares y los recursos marinos para el desarrollo sostenible</ns1:prefLabel>
    <ns1:prefLabel xml:lang="en">Conserve and sustainably use the oceans, seas and marine resources for sustainable development</ns1:prefLabel>
    <ns1:prefLabel xml:lang="fr">Conserver et exploiter de manière durable les océans, les mers et les ressources marines aux fins du développement durable</ns1:prefLabel>
    <ns4:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-10</ns4:created>
