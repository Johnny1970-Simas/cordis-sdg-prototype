  <rdf:Description rdf:about="http://data.europa.eu/sdg/1">
    <rdf:type rdf:resource="http://metadata.un.org/sdg/ontology#Goal" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <ns2:versionInfo>1.0</ns2:versionInfo>
    <ns1:prefLabel xml:lang="fr">Éliminer la pauvreté sous toutes ses formes et partout dans le monde</ns1:prefLabel>
    <ns1:prefLabel xml:lang="en">End poverty in all its forms everywhere</ns1:prefLabel>
    <ns1:prefLabel xml:lang="es">Poner fin a la pobreza en todas sus formas y en todo el mundo</ns1:prefLabel>
    <ns4:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-10</ns4:created>
