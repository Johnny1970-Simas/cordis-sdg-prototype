<rdf:Description rdf:about="http://data.europa.eu/sdg/12">
    <ns1:narrower rdf:resource="http://data.europa.eu/sdg/12.5" />
    <ns6:hasTarget rdf:resource="http://data.europa.eu/sdg/12.5" />
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/sdg/12.5">
    <rdf:type rdf:resource="http://metadata.un.org/sdg/ontology#Target" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <ns2:versionInfo>1.0</ns2:versionInfo>
    <ns1:prefLabel xml:lang="en">By 2030, substantially reduce waste generation through prevention, reduction, recycling and reuse</ns1:prefLabel>
    <ns1:prefLabel xml:lang="fr">D’ici à 2030, réduire nettement la production de déchets par la prévention, la réduction, le recyclage et la réutilisation</ns1:prefLabel>
    <ns1:prefLabel xml:lang="es">De aquí a 2030, reducir considerablemente la generación de desechos mediante actividades de prevención, reducción, reciclado y reutilización</ns1:prefLabel>
    <ns4:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-10</ns4:created>
    <ns1:inScheme rdf:resource="http://data.europa.eu/sdg" />
    <ns7:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-23</ns7:startDate>
