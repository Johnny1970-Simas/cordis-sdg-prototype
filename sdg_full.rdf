  <rdf:Description rdf:about="http://data.europa.eu/sdg/10.4">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="http://metadata.un.org/sdg/ontology#Target" />
    <ns2:versionInfo>1.0</ns2:versionInfo>
    <ns1:prefLabel xml:lang="fr">Adopter des politiques, notamment sur les plans budgétaire, salarial et dans le domaine de la protection sociale, afin de parvenir progressivement à une plus grande égalité</ns1:prefLabel>
    <ns1:prefLabel xml:lang="en">Adopt policies, especially fiscal, wage and social protection policies, and progressively achieve greater equality</ns1:prefLabel>
    <ns1:prefLabel xml:lang="es">Adoptar políticas, especialmente fiscales, salariales y de protección social, y lograr progresivamente una mayor igualdad</ns1:prefLabel>
    <ns4:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-10</ns4:created>
    <ns1:inScheme rdf:resource="http://data.europa.eu/sdg" />
