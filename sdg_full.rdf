  <rdf:Description rdf:about="http://data.europa.eu/sdg/13">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="http://metadata.un.org/sdg/ontology#Goal" />
    <ns2:versionInfo>1.0</ns2:versionInfo>
    <ns1:prefLabel xml:lang="en">Take urgent action to combat climate change and its impacts</ns1:prefLabel>
    <ns1:prefLabel xml:lang="es">Adoptar medidas urgentes para combatir el cambio climático y sus efectos</ns1:prefLabel>
    <ns1:prefLabel xml:lang="fr">Prendre d’urgence des mesures pour lutter contre les changements climatiques et leurs répercussions</ns1:prefLabel>
    <ns4:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-10</ns4:created>
    <ns1:inScheme rdf:resource="http://data.europa.eu/sdg" />
