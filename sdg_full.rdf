<rdf:Description rdf:about="http://data.europa.eu/sdg/17">
    <ns1:narrower rdf:resource="http://data.europa.eu/sdg/17.3" />
    <ns6:hasTarget rdf:resource="http://data.europa.eu/sdg/17.3" />
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/sdg/17.3">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="http://metadata.un.org/sdg/ontology#Target" />
    <ns2:versionInfo>1.0</ns2:versionInfo>
    <ns1:prefLabel xml:lang="es">Movilizar recursos financieros adicionales de múltiples fuentes para los países en desarrollo</ns1:prefLabel>
    <ns1:prefLabel xml:lang="fr">Mobiliser des ressources financières supplémentaires de diverses provenances en faveur des pays en développement</ns1:prefLabel>
    <ns1:prefLabel xml:lang="en">Mobilize additional financial resources for developing countries from multiple sources</ns1:prefLabel>
