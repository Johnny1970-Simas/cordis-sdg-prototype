  <rdf:Description rdf:about="http://data.europa.eu/sdg/10.5">
    <rdf:type rdf:resource="http://metadata.un.org/sdg/ontology#Target" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <ns2:versionInfo>1.0</ns2:versionInfo>
    <ns1:prefLabel xml:lang="es">Mejorar la reglamentación y vigilancia de las instituciones y los mercados financieros mundiales y fortalecer la aplicación de esos reglamentos</ns1:prefLabel>
    <ns1:prefLabel xml:lang="fr">Améliorer la réglementation et la surveillance des institutions et marchés financiers mondiaux et renforcer l’application des règles</ns1:prefLabel>
    <ns1:prefLabel xml:lang="en">Improve the regulation and monitoring of global financial markets and institutions and strengthen the implementation of such regulations</ns1:prefLabel>
    <ns4:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-10</ns4:created>
    <ns1:inScheme rdf:resource="http://data.europa.eu/sdg" />
