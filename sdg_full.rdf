<rdf:Description rdf:about="http://data.europa.eu/sdg/8">
    <ns1:narrower rdf:resource="http://data.europa.eu/sdg/8.b" />
    <ns6:hasTarget rdf:resource="http://data.europa.eu/sdg/8.b" />
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/sdg/8.b">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="http://metadata.un.org/sdg/ontology#Target" />
    <ns2:versionInfo>1.0</ns2:versionInfo>
    <ns1:prefLabel xml:lang="fr">D’ici à 2020, élaborer et mettre en œuvre une stratégie mondiale en faveur de l’emploi des jeunes et appliquer le Pacte mondial pour l’emploi de l’Organisation internationale du Travail</ns1:prefLabel>
    <ns1:prefLabel xml:lang="en">By 2020, develop and operationalize a global strategy for youth employment and implement the Global Jobs Pact of the International Labour Organization</ns1:prefLabel>
    <ns1:prefLabel xml:lang="es">De aquí a 2020, desarrollar y poner en marcha una estrategia mundial para el empleo de los jóvenes y aplicar el Pacto Mundial para el Empleo de la Organización Internacional del Trabajo</ns1:prefLabel>
    <ns4:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-10</ns4:created>
    <ns1:inScheme rdf:resource="http://data.europa.eu/sdg" />
