    <ns1:prefLabel xml:lang="es">Reducir la desigualdad en los países y entre ellos</ns1:prefLabel>
    <ns1:prefLabel xml:lang="fr">Réduire les inégalités dans les pays et d’un pays à l’autre</ns1:prefLabel>
