  <rdf:Description rdf:about="http://data.europa.eu/sdg/17.5">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="http://metadata.un.org/sdg/ontology#Target" />
    <ns2:versionInfo>1.0</ns2:versionInfo>
    <ns1:prefLabel xml:lang="en">Adopt and implement investment promotion regimes for least developed countries</ns1:prefLabel>
    <ns1:prefLabel xml:lang="es">Adoptar y aplicar sistemas de promoción de las inversiones en favor de los países menos adelantados</ns1:prefLabel>
    <ns1:prefLabel xml:lang="fr">Adopter et mettre en œuvre des dispositifs visant à encourager l’investissement en faveur des pays les moins avancés</ns1:prefLabel>
    <ns4:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-10</ns4:created>
    <ns1:inScheme rdf:resource="http://data.europa.eu/sdg" />
