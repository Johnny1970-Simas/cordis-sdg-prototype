    <ns2:versionInfo>1.0</ns2:versionInfo>
    <ns1:prefLabel xml:lang="es">De aquí a 2030, lograr el acceso universal y equitativo al agua potable a un precio asequible para todos</ns1:prefLabel>
    <ns1:prefLabel xml:lang="fr">D’ici à 2030, assurer l’accès universel et équitable à l’eau potable, à un coût abordable</ns1:prefLabel>
    <ns1:prefLabel xml:lang="en">By 2030, achieve universal and equitable access to safe and affordable drinking water for all</ns1:prefLabel>
    <ns4:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-10</ns4:created>
