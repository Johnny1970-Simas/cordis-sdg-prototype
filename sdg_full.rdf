<rdf:Description rdf:about="http://data.europa.eu/sdg/7.3">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="http://metadata.un.org/sdg/ontology#Target" />
    <ns2:versionInfo>1.0</ns2:versionInfo>
    <ns1:prefLabel xml:lang="fr">D’ici à 2030, multiplier par deux le taux mondial d’amélioration de l’efficacité énergétique</ns1:prefLabel>
    <ns1:prefLabel xml:lang="es">De aquí a 2030, duplicar la tasa mundial de mejora de la eficiencia energética</ns1:prefLabel>
    <ns1:prefLabel xml:lang="en">By 2030, double the global rate of improvement in energy efficiency</ns1:prefLabel>
    <ns4:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-10</ns4:created>
    <ns1:inScheme rdf:resource="http://data.europa.eu/sdg" />
