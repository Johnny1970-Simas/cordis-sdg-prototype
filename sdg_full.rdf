  <rdf:Description rdf:about="http://data.europa.eu/sdg/17.15">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="http://metadata.un.org/sdg/ontology#Target" />
    <ns2:versionInfo>1.0</ns2:versionInfo>
    <ns1:prefLabel xml:lang="fr">Respecter la marge de manœuvre et l’autorité de chaque pays en ce qui concerne l’élaboration et l’application des politiques d’élimination de la pauvreté et de développement durable</ns1:prefLabel>
    <ns1:prefLabel xml:lang="es">Respetar el margen normativo y el liderazgo de cada país para establecer y aplicar políticas de erradicación de la pobreza y desarrollo sostenible</ns1:prefLabel>
    <ns1:prefLabel xml:lang="en">Respect each country’s policy space and leadership to establish and implement policies for poverty eradication and sustainable development</ns1:prefLabel>
