<rdf:Description rdf:about="http://data.europa.eu/sdg/C040401">
    <ns1:broader rdf:resource="http://data.europa.eu/sdg/4.4" />
    <ns6:isIndicatorOf rdf:resource="http://data.europa.eu/sdg/4.4" />
