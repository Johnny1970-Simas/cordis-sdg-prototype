<rdf:Description rdf:about="http://data.europa.eu/sdg/C150801">
    <ns1:broader rdf:resource="http://data.europa.eu/sdg/15.8" />
    <ns6:isIndicatorOf rdf:resource="http://data.europa.eu/sdg/15.8" />
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/sdg/15">
    <ns1:narrower rdf:resource="http://data.europa.eu/sdg/15.8" />
    <ns6:hasTarget rdf:resource="http://data.europa.eu/sdg/15.8" />
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/sdg/15.8">
    <rdf:type rdf:resource="http://metadata.un.org/sdg/ontology#Target" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <ns2:versionInfo>1.0</ns2:versionInfo>
    <ns1:prefLabel xml:lang="es">De aquí a 2020, adoptar medidas para prevenir la introducción de especies exóticas invasoras y reducir significativamente sus efectos en los ecosistemas terrestres y acuáticos y controlar o erradicar las especies prioritarias</ns1:prefLabel>
    <ns1:prefLabel xml:lang="fr">D’ici à 2020, prendre des mesures pour empêcher l’introduction d’espèces exotiques envahissantes, atténuer sensiblement les effets que ces espèces ont sur les écosystèmes terrestres et aquatiques et contrôler ou éradiquer les espèces prioritaires</ns1:prefLabel>
    <ns1:prefLabel xml:lang="en">By 2020, introduce measures to prevent the introduction and significantly reduce the impact of invasive alien species on land and water ecosystems and control or eradicate the priority species</ns1:prefLabel>
    <ns4:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-10</ns4:created>
    <ns1:inScheme rdf:resource="http://data.europa.eu/sdg" />
    <ns7:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-23</ns7:startDate>
    <ns5:prefLabel rdf:resource="http://data.europa.eu/sdg/label_21b5618b85" />
    <ns5:prefLabel rdf:resource="http://data.europa.eu/sdg/label_669de07826" />
    <ns5:prefLabel rdf:resource="http://data.europa.eu/sdg/label_cb736373e6" />
    <dc:identifier>15.8</dc:identifier>
    <ns1:broader rdf:resource="http://data.europa.eu/sdg/15" />
    <ns1:narrower rdf:resource="http://data.europa.eu/sdg/C150801" />
    <ns1:notation rdf:datatype="http://metadata.un.org/sdg/ontology#SDGCodeCompact">15.8</ns1:notation>
    <ns1:notation>15.8</ns1:notation>
    <ns1:notation rdf:datatype="http://metadata.un.org/sdg/ontology#SDGCode">15.08</ns1:notation>
