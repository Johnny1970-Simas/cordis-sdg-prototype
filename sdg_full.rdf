    <ns1:notation>17.17</ns1:notation>
    <ns1:notation rdf:datatype="http://metadata.un.org/sdg/ontology#SDGCodeCompact">17.17</ns1:notation>
    <ns7:status rdf:resource="http://publications.europa.eu/resource/authority/concept-status/CURRENT" />
