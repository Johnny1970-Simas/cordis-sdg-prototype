  <rdf:Description rdf:about="http://data.europa.eu/sdg/3.5">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="http://metadata.un.org/sdg/ontology#Target" />
    <ns2:versionInfo>1.0</ns2:versionInfo>
    <ns1:prefLabel xml:lang="fr">Renforcer la prévention et le traitement de l’abus de substances psychoactives, notamment de stupéfiants et d’alcool</ns1:prefLabel>
    <ns1:prefLabel xml:lang="es">Fortalecer la prevención y el tratamiento del abuso de sustancias adictivas, incluido el uso indebido de estupefacientes y el consumo nocivo de alcohol</ns1:prefLabel>
    <ns1:prefLabel xml:lang="en">Strengthen the prevention and treatment of substance abuse, including narcotic drug abuse and harmful use of alcohol</ns1:prefLabel>
    <ns4:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-10</ns4:created>
    <ns1:inScheme rdf:resource="http://data.europa.eu/sdg" />
