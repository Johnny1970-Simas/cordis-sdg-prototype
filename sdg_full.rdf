  <rdf:Description rdf:about="http://data.europa.eu/sdg/8">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="http://metadata.un.org/sdg/ontology#Goal" />
    <ns2:versionInfo>1.0</ns2:versionInfo>
    <ns1:prefLabel xml:lang="fr">Promouvoir une croissance économique soutenue, partagée et durable, le plein emploi productif et un travail décent pour tous</ns1:prefLabel>
    <ns1:prefLabel xml:lang="en">Promote sustained, inclusive and sustainable economic growth, full and productive employment and decent work for all</ns1:prefLabel>
    <ns1:prefLabel xml:lang="es">Promover el crecimiento económico sostenido, inclusivo y sostenible, el empleo pleno y productivo y el trabajo decente para todos</ns1:prefLabel>
    <ns4:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-10</ns4:created>
    <ns1:inScheme rdf:resource="http://data.europa.eu/sdg" />
