  <rdf:Description rdf:about="http://data.europa.eu/sdg/1.1">
    <rdf:type rdf:resource="http://metadata.un.org/sdg/ontology#Target" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <ns2:versionInfo>1.0</ns2:versionInfo>
    <ns1:prefLabel xml:lang="es">De aquí a 2030, erradicar para todas las personas y en todo el mundo la pobreza extrema (actualmente se considera que sufren pobreza extrema las personas que viven con menos de 1,25 dólares de los Estados Unidos al día)</ns1:prefLabel>
    <ns1:prefLabel xml:lang="en">By 2030, eradicate extreme poverty for all people everywhere, currently measured as people living on less than $1.25 a day</ns1:prefLabel>
    <ns1:prefLabel xml:lang="fr">D’ici à 2030, éliminer complètement l’extrême pauvreté dans le monde entier (s’entend actuellement du fait de vivre avec moins de 1,25 dollar des États‑Unis par jour)</ns1:prefLabel>
    <ns4:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-10</ns4:created>
    <ns1:inScheme rdf:resource="http://data.europa.eu/sdg" />
    <ns7:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-23</ns7:startDate>
