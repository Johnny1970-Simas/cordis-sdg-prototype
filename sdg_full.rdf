<rdf:Description rdf:about="http://data.europa.eu/sdg/6">
    <ns1:narrower rdf:resource="http://data.europa.eu/sdg/6.6" />
    <ns6:hasTarget rdf:resource="http://data.europa.eu/sdg/6.6" />
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/sdg/6.6">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="http://metadata.un.org/sdg/ontology#Target" />
    <ns2:versionInfo>1.0</ns2:versionInfo>
    <ns1:prefLabel xml:lang="es">De aquí a 2020, proteger y restablecer los ecosistemas relacionados con el agua, incluidos los bosques, las montañas, los humedales, los ríos, los acuíferos y los lagos</ns1:prefLabel>
    <ns1:prefLabel xml:lang="fr">D’ici à 2020, protéger et restaurer les écosystèmes liés à l’eau, notamment les montagnes, les forêts, les zones humides, les rivières, les aquifères et les lacs</ns1:prefLabel>
    <ns1:prefLabel xml:lang="en">By 2020, protect and restore water-related ecosystems, including mountains, forests, wetlands, rivers, aquifers and lakes</ns1:prefLabel>
    <ns4:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-10</ns4:created>
    <ns1:inScheme rdf:resource="http://data.europa.eu/sdg" />
