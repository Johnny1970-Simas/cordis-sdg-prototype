<rdf:Description rdf:about="http://data.europa.eu/sdg/C120301">
    <ns1:broader rdf:resource="http://data.europa.eu/sdg/12.3" />
    <ns6:isIndicatorOf rdf:resource="http://data.europa.eu/sdg/12.3" />
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/sdg/12">
    <ns1:narrower rdf:resource="http://data.europa.eu/sdg/12.3" />
