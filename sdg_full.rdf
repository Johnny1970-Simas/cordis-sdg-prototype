    <ns5:prefLabel rdf:resource="http://data.europa.eu/sdg/label_50c307e7c9" />
    <ns5:prefLabel rdf:resource="http://data.europa.eu/sdg/label_c0333e6098" />
    <dc:identifier>7.a</dc:identifier>
    <ns1:broader rdf:resource="http://data.europa.eu/sdg/7" />
    <ns1:narrower rdf:resource="http://data.europa.eu/sdg/C070a01" />
