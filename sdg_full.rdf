  <rdf:Description rdf:about="http://data.europa.eu/sdg/5.1">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="http://metadata.un.org/sdg/ontology#Target" />
    <ns2:versionInfo>1.0</ns2:versionInfo>
    <ns1:prefLabel xml:lang="en">End all forms of discrimination against all women and girls everywhere</ns1:prefLabel>
    <ns1:prefLabel xml:lang="es">Poner fin a todas las formas de discriminación contra todas las mujeres y las niñas en todo el mundo</ns1:prefLabel>
    <ns1:prefLabel xml:lang="fr">Mettre fin, partout dans le monde, à toutes les formes de discrimination à l’égard des femmes et des filles</ns1:prefLabel>
    <ns4:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-10</ns4:created>
    <ns1:inScheme rdf:resource="http://data.europa.eu/sdg" />
    <ns7:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-23</ns7:startDate>
    <ns5:prefLabel rdf:resource="http://data.europa.eu/sdg/label_07d54c6a18" />
    <ns5:prefLabel rdf:resource="http://data.europa.eu/sdg/label_ec5367df41" />
