  <rdf:Description rdf:about="http://data.europa.eu/sdg/2">
    <rdf:type rdf:resource="http://metadata.un.org/sdg/ontology#Goal" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <ns2:versionInfo>1.0</ns2:versionInfo>
    <ns1:prefLabel xml:lang="fr">Éliminer la faim, assurer la sécurité alimentaire, améliorer la nutrition et promouvoir l’agriculture durable</ns1:prefLabel>
    <ns1:prefLabel xml:lang="en">End hunger, achieve food security and improved nutrition and promote sustainable agriculture</ns1:prefLabel>
    <ns1:prefLabel xml:lang="es">Poner fin al hambre, lograr la seguridad alimentaria y la mejora de la nutrición y promover la agricultura sostenible</ns1:prefLabel>
    <ns4:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-10</ns4:created>
