  <rdf:Description rdf:about="http://data.europa.eu/sdg/C130a01">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="http://metadata.un.org/sdg/ontology#Indicator" />
    <ns2:versionInfo>1.0</ns2:versionInfo>
    <ns1:prefLabel xml:lang="es">Suma anual, en dólares de los Estados Unidos, movilizada entre 2020 y 2025 como parte del compromiso de llegar a 100.000 millones de dólares</ns1:prefLabel>
    <ns1:prefLabel xml:lang="fr">Montant (en dollars des États‑Unis) des ressources mobilisées par année, de 2020 à 2025, au titre de l’engagement de 100 milliards de dollars </ns1:prefLabel>
    <ns1:prefLabel xml:lang="en">Mobilized amount of United States dollars per year between 2020 and 2025 accountable towards the $100 billion commitment</ns1:prefLabel>
    <ns4:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-10</ns4:created>
    <ns1:inScheme rdf:resource="http://data.europa.eu/sdg" />
    <ns7:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-23</ns7:startDate>
    <ns5:prefLabel rdf:resource="http://data.europa.eu/sdg/label_c511483b1a" />
    <ns5:prefLabel rdf:resource="http://data.europa.eu/sdg/label_b86be4c9b7" />
    <ns5:prefLabel rdf:resource="http://data.europa.eu/sdg/label_131bd25b7c" />
    <dc:identifier>C130a01</dc:identifier>
    <ns1:broader rdf:resource="http://data.europa.eu/sdg/13.a" />
