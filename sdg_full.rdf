  <rdf:Description rdf:about="http://data.europa.eu/sdg/4">
    <rdf:type rdf:resource="http://metadata.un.org/sdg/ontology#Goal" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <ns2:versionInfo>1.0</ns2:versionInfo>
    <ns1:prefLabel xml:lang="fr">Assurer à tous une éducation équitable, inclusive et de qualité et des possibilités d’apprentissage    tout au long de la vie</ns1:prefLabel>
    <ns1:prefLabel xml:lang="en">Ensure inclusive and equitable quality education and promote lifelong learning opportunities for all</ns1:prefLabel>
    <ns1:prefLabel xml:lang="es">Garantizar una educación inclusiva y equitativa de calidad y promover oportunidades de aprendizaje permanente para todos</ns1:prefLabel>
    <ns4:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-10</ns4:created>
