    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <rdf:type rdf:resource="http://metadata.un.org/sdg/ontology#Target" />
    <ns2:versionInfo>1.0</ns2:versionInfo>
    <ns1:prefLabel xml:lang="en">Promote and enforce non-discriminatory laws and policies for sustainable development</ns1:prefLabel>
    <ns1:prefLabel xml:lang="es">Promover y aplicar leyes y políticas no discriminatorias en favor del desarrollo sostenible</ns1:prefLabel>
    <ns1:prefLabel xml:lang="fr">Promouvoir et appliquer des lois et politiques non discriminatoires pour le développement durable</ns1:prefLabel>
    <ns4:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-10</ns4:created>
