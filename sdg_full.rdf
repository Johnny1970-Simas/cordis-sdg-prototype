<rdf:Description rdf:about="http://data.europa.eu/sdg/15">
    <ns1:narrower rdf:resource="http://data.europa.eu/sdg/15.6" />
    <ns6:hasTarget rdf:resource="http://data.europa.eu/sdg/15.6" />
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/sdg/15.6">
    <rdf:type rdf:resource="http://metadata.un.org/sdg/ontology#Target" />
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept" />
    <ns2:versionInfo>1.0</ns2:versionInfo>
    <ns1:prefLabel xml:lang="en">Promote fair and equitable sharing of the benefits arising from the utilization of genetic resources and promote appropriate access to such resources, as internationally agreed</ns1:prefLabel>
    <ns1:prefLabel xml:lang="es">Promover la participación justa y equitativa en los beneficios derivados de la utilización de los recursos genéticos y promover el acceso adecuado a esos recursos, según lo convenido internacionalmente</ns1:prefLabel>
    <ns1:prefLabel xml:lang="fr">Favoriser le partage juste et équitable des bénéfices découlant de l’utilisation des ressources génétiques et promouvoir un accès approprié à celles-ci, ainsi que cela a été décidé à l’échelle internationale</ns1:prefLabel>
    <ns4:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-10</ns4:created>
    <ns1:inScheme rdf:resource="http://data.europa.eu/sdg" />
    <ns7:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-09-23</ns7:startDate>
